# Campus Customs — environment
#
# The real .env lives at the course root and is gitignored. Copy this file to
# .env (here or at any parent folder) and fill in the key; backend/agents/config.py
# walks up the directory tree and loads the nearest one it finds.

# Required — Portkey gateway key for all model calls.
PORTKEY_API_KEY=

# Optional — the only model this project uses. Change it here and nowhere else;
# the name appears exactly once in code, at backend/agents/config.py.
MODEL_NAME=gpt-6-luna

# Optional — defaults to the public Portkey endpoint.
PORTKEY_BASE_URL=https://api.portkey.ai/v1
